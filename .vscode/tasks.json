{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Compilar Calculadora",
            "command": "/usr/bin/g++",
            "args": [
                "-Wall",
                "-Wextra",
                "-g3",
                "${workspaceFolder}/main.cpp",
                "${workspaceFolder}/logic.cpp",
                "${workspaceFolder}/ui.cpp",
                "-o",
                "${workspaceFolder}/output/shuracalculator"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compilación completa de la calculadora"
        }
    ]
}
